@Getter
@Setter
public
  {{#if entitySchema.x-isExtended}}abstract {{/if}}
    {{#if className}}
      class {{className}}DTO
    {{else}}
      class {{entityName}}DTO
    {{/if}}
  {{#if entitySchema.x-extends}}
    extends {{capitalize entitySchema.x-extends}}DTO
  {{else}}
    {{! If it doesn't extend, and has an ID field, it should implement HasId }}
    {{#if (and entitySchema.properties.id (eq entitySchema.properties.id.type 'string'))}}
      implements HasId
    {{/if}}
  {{/if}} {

  {{#each entitySchema.properties}}

    {{#eq type 'string'}}
      {{! Strings should have a max length of 500 unless otherwise specified }}
      {{#if minLength}}
        @Size(min = {{minLength}}, max = {{fallback maxLength 500}})
      {{else}}
        @Size(max = {{fallback maxLength 500}})
      {{/if}}

      {{#if pattern}}
      @Pattern(regexp = "{{pattern}}")
      {{/if}}

      {{#if (eq format 'email')}}
      @Email

      {{else if (eq format 'date-time')}}
      @DateTimeFormat(iso = DateTimeFormat.ISO.DATE_TIME)

      {{else if (eq format 'date')}}
      @DateTimeFormat(iso = DateTimeFormat.ISO.DATE)

      {{else if (eq format 'url')}}
      @URL

      {{else if (eq format 'password')}}
      @Password
      {{! Currently noop, avoid setting NoSSN }}

      {{else if enum}}
      {{! Currently noop, avoid setting NoSSN }}

      {{else}}
      @NoSSN

      {{/if}}

      {{#if (and enum (ne (length enum) 1) (ne (length enum) 0))}}
      @ValidEnum(enumClass = {{capitalize @key}}Enum.class)
      {{/if}}
    {{/eq}}

    {{#if readOnly}}
      {{#unless (and enum (eq (length enum) 1))}}
        @Null(groups = {Insert.class, Update.class})
      {{/unless}}
    {{else}}
      {{#if x-required}}
        @NotNull(groups = {Insert.class})
      {{/if}}
    {{/if}}

    {{#if x-expandableField}}
    @Valid
    {{/if}}

      {{! Enums with length 1 should be final }}
      {{#if (and enum (eq (length enum) 1))}}
        final
      {{/if}}

      {{! transient values won't be serialized }}
      {{#if writeOnly}}transient {{/if}}

      {{! Data type }}
      {{#if (eq type 'object')}}
        {{capitalize @key}}DTO
      {{else}}
        {{{java-server-datatype . @key ../entityName}}}
      {{/if}}

      {{! Field name }}
      {{@key}}

      {{! Set default value if specified }}
      {{#if default}} = 
        {{#if (eq type 'string')}}
          "{{default}}"
        {{else}}
          {{default}}
        {{/if}}
      {{/if}}
      ;

  {{/each}}

{{#if inlineEnums}}
  {{#each entitySchema.properties}}
    {{#if enum}}
      public enum {{capitalize @key}}Enum {
        {{#each enum}}
        {{const-var-name .}}("{{.}}"){{#unless @last}},{{/unless}}
        {{/each}};

        private final String value;

        {{capitalize @key}}Enum(String value) {
          this.value = value;
        }

        @Override
        public String toString() {
          return value;
        }

        public String toJson() {
          return value;
        }

        public static {{capitalize @key}}Enum fromValue(String value) {
          for ({{capitalize @key}}Enum val : values()) {
            if (val.value.equals(value)) {
                return val;
            }
          }
          throw new IllegalArgumentException("No enum constant for value: " + value);
        }
      }
    {{/if}}
  {{/each}}
{{/if}}

{{! Add objects for object properties }}
{{#each entitySchema.properties}}
  {{#if (eq type 'object')}}
    {{> modelPartial entitySchema=. entityName=../entityName className=(capitalize @key) inlineEnums=inlineEnums entityName=entityName}}
  {{/if}}
{{/each}}

}
